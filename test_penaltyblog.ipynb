import penaltyblog as pb

# 1. Fetch data (Example: English Premier League 2024-2025 season)
df = pb.scrapers.FootballData("Spain", 2026, 0).fetch()

# 2. Instantiate the Dixon-Coles Model
# Map your dataframe columns: Home Goals, Away Goals, Home Team, Away Team
dc = pb.models.DixonColesGoalModel(
    df["FTHG"], 
    df["FTAG"], 
    df["HomeTeam"], 
    df["AwayTeam"]
)

# 3. Fit the model to find the optimal team parameters
dc.fit()

# 4. View the fitted parameters (Attack, Defence, Home Advantage, and Rho)
print(dc)
